# ==============================================================================
# taskctl - Environment Configuration & Secrets Isolation
# ==============================================================================
# Only variables read by v0.1.0 are listed. Leave unset to keep the matching
# integration disabled. Never commit real tokens or socket paths.

# Webhook lifecycle dispatcher (fail-safe; delivery errors never abort commits)
# TASKCTL_WEBHOOK_URL="http://localhost:8080/api/v1/events"

# Vector / VictoriaLogs HTTP sink
# TASKCTL_VECTOR_URL="http://127.0.0.1:8686/logs"
# VECTOR_URL="http://127.0.0.1:8686/logs"
# VECTOR_HOST="127.0.0.1"
# VECTOR_HTTP_PORT="8686"
# TASKCTL_TELEMETRY_TIMEOUT="2.0"
# TASKCTL_TELEMETRY_DEBUG="1"
# TASKCTL_LOG_NDJSON="1"

# Cross-repo daemon watch list (os.pathsep-separated absolute paths)
# TASKCTL_WATCH_REPOS="/home/me/repo-a:/home/me/repo-b"

# Distributed tracing and SLA thresholds
# TRACEPARENT="00-<trace_id>-<span_id>-01"
# TASKCTL_TRACEPARENT="00-<trace_id>-<span_id>-01"
# TASKCTL_TRACE_ID=""
# TASKCTL_TRACE_HISTORY="500"
# TASKCTL_SLA_AUDIT_MS="8000"
# TASKCTL_SLA_PROVIDER_MS="3000"
# TASKCTL_SLA_COMMAND_MS="10000"
# TASKCTL_SLA_TASK_HOURS="24"

# Maestri canvas adapter (UNIX socket, with CLI fallback)
# MAESTRI_SOCKET_PATH="/run/user/1000/maestri.sock"
# MAESTRI_SOCKET="/run/user/1000/maestri.sock"
# MAESTRI_CLI="maestri"

# Telemetry identity fields (optional overrides)
# SERVICE_NAME="taskctl"
# APP_NAME="taskctl"
# ENV="production"
