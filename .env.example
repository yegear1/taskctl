# ==============================================================================
# taskctl - Environment Configuration & Secrets Isolation
# ==============================================================================

# Webhook Telemetry Dispatcher (Non-blocking fail-safe delivery)
# TASKCTL_WEBHOOK_URL="http://localhost:8080/api/v1/events"
# TASKCTL_WEBHOOK_TOKEN="your-secure-webhook-bearer-token"
# TASKCTL_TIMEOUT_SEC="2.0"

# Multi-Agent Orchestration Providers
# MAESTRI_SOCKET_PATH="/run/user/1000/maestri.sock"
# MULTIGRAVITY_PROFILE="yegear"

# Logging Level (DEBUG | INFO | WARNING | ERROR)
TASKCTL_LOG_LEVEL="INFO"
